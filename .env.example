# 复制为 .env 后填写，切勿提交真实密钥
TRAE_ADMIN_API_KEY=
DINGTALK_WEBHOOK=
DINGTALK_SECRET=
# 行动建议展示星期：0=周日 … 6=周六，默认 1=周一
# SUGGESTION_WEEKDAY=1
# 异常高消耗：最低金额（美元/日，默认 50）+ 绝对阈值（默认 100）与均值倍数（默认 3）
# ALERT_MIN_SPEND_USD=50
# ALERT_DAILY_SPEND_USD=100
# ALERT_AVG_MULTIPLIER=3
# 部门映射（可选）：仅当 API 未返回部门字段时作为兜底
# JSON 格式，key=成员邮箱，value=部门名称
# DEPT_MAPPING={"alice@xizi.com":"前端组","bob@xizi.com":"后端组"}